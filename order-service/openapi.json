{
  "openapi": "3.0.0",
  "info": { "title": "Order Service API", "version": "1.0.0", "description": "Checkout, order history and internal order status APIs exposed through API Gateway." },
  "servers": [{ "url": "http://localhost:8000/api/orders", "description": "API Gateway route" }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "internalToken": { "type": "apiKey", "in": "header", "name": "x-internal-token" }
    }
  },
  "paths": {
    "/health": { "get": { "summary": "Health check", "tags": ["Health"], "responses": { "200": { "description": "Service is healthy" }, "503": { "description": "Service is degraded" } } } },
    "/checkout": { "post": { "summary": "Checkout current cart", "tags": ["Orders"], "security": [{ "bearerAuth": [] }], "parameters": [{ "in": "header", "name": "x-idempotency-key", "required": true, "schema": { "type": "string", "minLength": 8 } }], "responses": { "202": { "description": "Order created" }, "200": { "description": "Idempotent replay" }, "400": { "description": "Invalid request" }, "401": { "description": "Unauthorized" } } } },
    "/history": { "get": { "summary": "Get current user's order history", "tags": ["Orders"], "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Order history" }, "401": { "description": "Unauthorized" } } } },
    "/{orderId}": { "get": { "summary": "Get current user's order detail", "tags": ["Orders"], "security": [{ "bearerAuth": [] }], "parameters": [{ "in": "path", "name": "orderId", "required": true, "schema": { "type": "integer" } }], "responses": { "200": { "description": "Order detail" }, "404": { "description": "Not found" } } } },
    "/{orderId}/status": { "patch": { "summary": "Update order status", "tags": ["Admin Orders"], "security": [{ "internalToken": [] }], "parameters": [{ "in": "path", "name": "orderId", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "enum": ["PENDING", "CONFIRMED", "PAID", "CANCELLED", "EXPIRED", "Delivered"] } } } } } }, "responses": { "200": { "description": "Updated" }, "403": { "description": "Forbidden" } } } }
  }
}